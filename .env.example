# 服务器端口（Render 会自动设置 PORT 环境变量）
PORT=3000

# LLM API（智能行程生成用）
# 注意：BASE_URL 必须是完整的 chat completions 端点。
#   DeepSeek: https://api.deepseek.com/v1/chat/completions  model=deepseek-chat
#   智谱 GLM: https://open.bigmodel.cn/api/paas/v4/chat/completions  model=glm-4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
